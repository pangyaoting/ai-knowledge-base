# ========== 数据库配置 ==========
DB_USER=kbuser
DB_PASSWORD=kbpassword
DB_NAME=knowledge_base
DB_HOST=localhost
DB_PORT=5432
# 完整数据库连接串（Prisma 用）
DATABASE_URL=postgresql://kbuser:kbpassword@localhost:5432/knowledge_base?schema=public

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== 服务配置 ==========
SERVER_PORT=3000
# 上传单文件大小上限（MB），默认 20
MAX_FILE_SIZE_MB=20
JWT_SECRET=改成你自己的随机字符串至少32位
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=改成你自己的另一个随机字符串至少32位
JWT_REFRESH_EXPIRES_IN=7d

# ========== 演示/审核只读账号（可选）==========
# 逗号分隔的邮箱；这些账号的所有写操作会被服务端拒绝（403），只能 GET 浏览。
# 用途：给公安联网备案审核员 / 面试官一个能进门看东西的账号，同时保证他改不了数据、
# 也花不掉平台的钱（注意：不绑模型 Key 只挡住大模型调用，上传文档仍会用系统 Key 做向量化）。
# 留空 = 该守卫完全不生效（默认，不影响普通部署）。
# 前端登录页展示的账号见 apps/web/src/config/demo.ts（那边是公开的展示用配置）。
# 已启用示例：DEMO_READONLY_EMAILS=zhizhuojuzi.h@qq.com
DEMO_READONLY_EMAILS=

# ========== 邮箱验证码（SMTP）==========
# 不配置则走开发模式：验证码随接口响应返回（方便本地联调，生产必须配置真实 SMTP）
# 以 QQ 邮箱为例：登录 https://mail.qq.com → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码作为 MAIL_PASS
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=你的QQ邮箱@qq.com
# MAIL_PASS=你的SMTP授权码
# MAIL_FROM=AI 知识库 <你的QQ邮箱@qq.com>

# ========== BYO 模型配置（用户自带大模型 Key） ==========
# 用户配置的 API Key 用 AES-256-GCM 加密落库，此密钥用 `openssl rand -hex 32` 生成
# （缺失时自动由 JWT_SECRET 派生，生产环境务必显式配置）
MODEL_KEY_SECRET=用openssl-rand-hex-32生成的64位hex

# ========== AI 配置 ==========
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动 Embedding（在 https://cloud.siliconflow.cn 申请，有免费额度）
SILICONFLOW_API_KEY=sk-你的key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ========== 前端配置 ==========
VITE_API_BASE_URL=http://localhost:3000

# ========== 联网检索（Tavily，可选）==========
# 在 https://app.tavily.com 注册获取免费 key（1000 次/月）
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ========== 检索质量 ==========
# 向量相似度下限（低于此值的片段视为噪声，不进入回答；0~1）
MIN_SIMILARITY=0.35

# ========== 重排序（两阶段检索）==========
# 用硅基流动的 bge-reranker 对候选片段精排（不填则跳过重排，直接用 RRF 结果）
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排相关性门控下限（0~1；实测 bge-reranker 相关≈0.9+、无关≈0.00x，默认 0.1 足够）
# 低于阈值的片段直接丢弃 → 检索不到相关内容时走"模型自身知识 + 明示来源"兜底
RERANK_MIN_SCORE=0.1

