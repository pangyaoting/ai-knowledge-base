# ========== 数据库配置 ==========
DB_USER=kbuser
DB_PASSWORD=kbpassword
DB_NAME=knowledge_base
DB_HOST=localhost
DB_PORT=5432
# 完整数据库连接串（Prisma 用）
DATABASE_URL=postgresql://kbuser:kbpassword@localhost:5432/knowledge_base?schema=public

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== 服务配置 ==========
SERVER_PORT=3000
# 上传单文件大小上限（MB），默认 20
MAX_FILE_SIZE_MB=20
JWT_SECRET=改成你自己的随机字符串至少32位
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=改成你自己的另一个随机字符串至少32位
JWT_REFRESH_EXPIRES_IN=7d

# ========== AI 配置 ==========
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动 Embedding（在 https://cloud.siliconflow.cn 申请，有免费额度）
SILICONFLOW_API_KEY=sk-你的key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ========== 前端配置 ==========
VITE_API_BASE_URL=http://localhost:3000

# ========== 联网检索（Tavily，可选）==========
# 在 https://app.tavily.com 注册获取免费 key（1000 次/月）
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ========== 检索质量 ==========
# 向量相似度下限（低于此值的片段视为噪声，不进入回答；0~1）
MIN_SIMILARITY=0.35

# ========== 重排序（两阶段检索）==========
# 用硅基流动的 bge-reranker 对候选片段精排（不填则跳过重排，直接用 RRF 结果）
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

