// Prisma Schema - 数据模型定义
// 文档: https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector 扩展，用于存储向量
}

// ==================== 用户系统 ====================

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  nickname    String?
  avatar      String?
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  knowledgeBases KnowledgeBase[]
  chatSessions   ChatSession[]
  reports        Report[]
  agentTasks     AgentTask[]
  modelConfigs   ModelConfig[]

  @@map("users")
}

// ==================== 知识库 ====================

model KnowledgeBase {
  id          String     @id @default(uuid())
  name        String
  description String?
  ownerId     String     @map("owner_id")
  documents   Document[]
  sessionLinks SessionKnowledgeBase[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("knowledge_bases")
}

// ==================== 文档 ====================

model Document {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  filename        String // 原始文件名
  filepath        String // 服务器上存储路径
  fileSize        Int      @map("file_size") // 字节数
  fileType        String   @map("file_type") // pdf / docx / md / txt
  status          String   @default("pending") // pending / processing / done / failed
  error           String? // 失败原因
  contentHash     String?  @map("content_hash") // 文件内容 SHA-256（增量向量化：同名同哈希跳过）
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Chunk[]

  @@index([knowledgeBaseId])
  @@map("documents")
}

// ==================== 文本块（Chunk） ====================
// embedding 列类型是 pgvector 的 vector(1024)，Prisma 不支持，
// 用 Unsupported() 占位（列由原始 SQL 迁移创建，读写走 $executeRaw/$queryRaw）

model Chunk {
  id         String                    @id @default(uuid())
  documentId String                    @map("document_id")
  content    String // 文本块原文
  chunkIndex Int                       @map("chunk_index") // 第几块（保证顺序）
  parentId   String?                   @map("parent_id") // P2 父子分块：子块挂父块 id（命中子块取父块喂模型）
  embedding  Unsupported("vector(1024)")? // 向量（bge-m3 1024 维），Step 5 写入；父块无向量（不参与检索）
  createdAt  DateTime                  @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([parentId])
  @@map("chunks")
}

// ==================== 对话会话 ====================
// 会话可以绑定 0..N 个知识库（多对多，通过关联表 SessionKnowledgeBase）；
// useKnowledgeBase=true 且 0 个绑定 = 检索该用户全部知识库；
// useKnowledgeBase=false = 纯对话模式（不检索知识库）

model ChatSession {
  id               String        @id @default(uuid())
  ownerId          String        @map("owner_id")
  title            String        @default("新对话")
  useKnowledgeBase Boolean       @default(true) @map("use_knowledge_base") // false = 纯对话，不检索知识库
  modelConfigId    String?       @map("model_config_id") // 用户自带的模型配置（null = 系统默认）
  model            String? // 会话选中的模型名（同一配置下可切换多个模型；null = 用配置默认 model）
  reasoningEffort  String?       @map("reasoning_effort") // 推理等级：low(关闭≈最低) / high / max；null=默认
  messages         ChatMessage[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases SessionKnowledgeBase[]
  modelConfig    ModelConfig?           @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("chat_sessions")
}

// 会话-知识库 多对多关联表
model SessionKnowledgeBase {
  sessionId       String        @map("session_id")
  knowledgeBaseId String        @map("knowledge_base_id")
  session         ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([sessionId, knowledgeBaseId])
  @@index([knowledgeBaseId])
  @@map("session_knowledge_bases")
}

// ==================== 研究报告 ====================
// 研究报告：丢主题 → 自动拆解子问题 → 检索知识库 → 分节撰写 → 汇总成 Markdown。
// 异步生成：创建任务立即返回，worker 后台执行，前端轮询 status/step 展示进度。

model Report {
  id         String   @id @default(uuid())
  ownerId    String   @map("owner_id")
  topic      String // 研究主题
  status     String   @default("pending") // pending / processing / done / failed
  step       Int      @default(0) // 进度步骤：1=拆解子问题 2=检索撰写章节 3=汇总成报告
  tokensUsed Int      @default(0) @map("tokens_used") // 生成消耗的 token 总数（数据看板统计用）
  content    String? // 最终 Markdown 报告
  sections   Json? // [{ index, question, content }]
  sources    Json? // [{ number, documentId, chunkIndex, filename, similarity }]
  error      String? // 失败原因
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("reports")
}

// ==================== 用户模型配置（BYO 大模型 API） ====================
// 用户自带大模型 key（Cherry Studio 思路）：token 由用户买单，平台零成本。
// apiKey 用 AES-256-GCM 加密存储（密钥在服务端 env），接口永不返回明文。
// 会话可选一个配置：回答走用户的 key/baseURL/model；不配置则回退系统默认。
// 嵌入/检索仍用系统 key（保证检索质量一致、成本可控）。

model ModelConfig {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String // 备注名，如"我的 DeepSeek"
  baseURL   String   @default("https://api.deepseek.com") @map("base_url") // OpenAI 兼容接口地址
  apiKey    String   @map("api_key") // AES-GCM 密文（iv:tag:data base64）
  model     String // 默认模型名，如 deepseek-chat
  models    String[] @default([]) // 该配置下的全部模型名（同一 Key 多模型；空 = 只用 model）
  isDefault Boolean  @default(false) @map("is_default") // 新建会话默认使用
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([ownerId])
  @@map("model_configs")
}

// ==================== 对话消息 ====================
// 流式回答结束后才落库（中间态不写库），sources 存引用来源 JSON

model ChatMessage {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  role             String // user / assistant
  content          String // 完整消息内容
  imageDataUrl     String?  @map("image_data_url") // 图片（data URL，用户消息；单图/兼容旧数据）
  imageDataUrls    String?  @map("image_data_urls") // 多图（JSON 数组字符串，用户消息）
  sources          Json? // 引用来源：[{ documentId, filename, chunkIndex, content, similarity }]
  promptTokens     Int?     @map("prompt_tokens") // 流式请求输入 token（数据看板用）
  completionTokens Int?     @map("completion_tokens") // 流式请求输出 token
  createdAt        DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// ==================== 自主研究 Agent ====================
// 限时·限量：用户设定 时间窗 + token 预算 + 研究目标（可选），
// Agent 在窗口内自主"搜索→筛选→精读→提炼"多来源资料并成稿。
// 停止（预算用尽 / 时间到 / 手动）后保留部分成果，可续时/加预算从断点继续。
// progress 是续跑断点：各方向研究笔记、已精读 URL、已用搜索词、已缓存小节正文。

model AgentTask {
  id           String    @id @default(uuid())
  ownerId      String    @map("owner_id")
  mode         String    @default("targeted") // targeted=定向研究（有目标）/ open=自主探索（无目标，从知识库挖掘方向）
  goal         String? // 研究目标（open 模式为空）
  startAt      DateTime  @map("start_at") // 时间窗开始
  endAt        DateTime  @map("end_at") // 时间窗结束（停止硬上限）
  tokenBudget  Int       @map("token_budget") // token 预算上限（停止硬上限）
  tokensUsed   Int       @default(0) @map("tokens_used") // 已消耗 token（续跑时累加）
  searchRounds Int       @default(0) @map("search_rounds") // 已执行的联网搜索轮数
  pagesRead    Int       @default(0) @map("pages_read") // 已精读页面数
  status       String    @default("pending") // pending / running / stopped / done / failed
  stopReason   String?   @map("stop_reason") // budget_exhausted / time_exhausted / user_stopped / completed / error
  directions   Json? // [{ title, question, status(pending|active|done), rounds }]
  progress     Json? // 续跑断点：{ directions: [{ notes, readUrls, searchTerms, sectionContent }] }
  report       String? // 最终（或阶段性）Markdown 报告
  summary      String? // 执行摘要（先摘要后展开：报告顶部展示，正文小节可折叠展开）
  sources      Json? // [{ number, title, url }] 引用来源（网页）
  error        String? // 失败原因
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("agent_tasks")
}
