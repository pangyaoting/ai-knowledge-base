// Prisma Schema - 数据模型定义
// 文档: https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector 扩展，用于存储向量
}

// ==================== 用户系统 ====================

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  nickname    String?
  avatar      String?
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  knowledgeBases KnowledgeBase[]
  chatSessions   ChatSession[]
  reports        Report[]
  modelConfigs   ModelConfig[]

  @@map("users")
}

// ==================== 知识库 ====================

model KnowledgeBase {
  id          String     @id @default(uuid())
  name        String
  description String?
  ownerId     String     @map("owner_id")
  documents   Document[]
  sessionLinks SessionKnowledgeBase[]
  entities    GraphEntity[]
  relations   GraphRelation[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("knowledge_bases")
}

// ==================== 知识图谱（GraphRAG-lite） ====================
// 入库时用 LLM 从文档抽取"实体 + 关系"，构成私有知识网络；
// 多跳问答时沿关系扩展召回（解决普通 RAG 答不了"A 和 B 什么关系"的问题）；
// 实体按 知识库+文档+名称 去重，chunkIds 记录实体出现的文本块（供取回原文）。

model GraphEntity {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  documentId      String   @map("document_id")
  name            String // 实体名（文档原词）
  type            String   @default("概念") // 概念 / 技术 / 人物 / 组织 / 产品
  chunkIds        Json     @default("[]") @map("chunk_ids") // 该实体出现的文本块 id 列表
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, documentId, name])
  @@index([knowledgeBaseId])
  @@index([name])
  @@map("graph_entities")
}

model GraphRelation {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  documentId      String   @map("document_id")
  sourceName      String   @map("source_name")
  relation        String // 如 "使用" "属于" "包含"
  targetName      String   @map("target_name")
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, documentId, sourceName, relation, targetName])
  @@index([knowledgeBaseId])
  @@map("graph_relations")
}

// ==================== 文档 ====================

model Document {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  filename        String // 原始文件名
  filepath        String // 服务器上存储路径
  fileSize        Int      @map("file_size") // 字节数
  fileType        String   @map("file_type") // pdf / docx / md / txt
  status          String   @default("pending") // pending / processing / done / failed
  error           String? // 失败原因
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Chunk[]
  entities      GraphEntity[]
  relations     GraphRelation[]

  @@index([knowledgeBaseId])
  @@map("documents")
}

// ==================== 文本块（Chunk） ====================
// embedding 列类型是 pgvector 的 vector(1024)，Prisma 不支持，
// 用 Unsupported() 占位（列由原始 SQL 迁移创建，读写走 $executeRaw/$queryRaw）

model Chunk {
  id         String                    @id @default(uuid())
  documentId String                    @map("document_id")
  content    String // 文本块原文
  chunkIndex Int                       @map("chunk_index") // 第几块（保证顺序）
  embedding  Unsupported("vector(1024)")? // 向量（bge-m3 1024 维），Step 5 写入
  createdAt  DateTime                  @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// ==================== 对话会话 ====================
// 会话可以绑定 0..N 个知识库（多对多，通过关联表 SessionKnowledgeBase）；
// useKnowledgeBase=true 且 0 个绑定 = 检索该用户全部知识库；
// useKnowledgeBase=false = 纯对话模式（不检索知识库）

model ChatSession {
  id               String        @id @default(uuid())
  ownerId          String        @map("owner_id")
  title            String        @default("新对话")
  useKnowledgeBase Boolean       @default(true) @map("use_knowledge_base") // false = 纯对话，不检索知识库
  modelConfigId    String?       @map("model_config_id") // 用户自带的模型配置（null = 系统默认）
  messages         ChatMessage[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases SessionKnowledgeBase[]
  modelConfig    ModelConfig?           @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@map("chat_sessions")
}

// 会话-知识库 多对多关联表
model SessionKnowledgeBase {
  sessionId       String        @map("session_id")
  knowledgeBaseId String        @map("knowledge_base_id")
  session         ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([sessionId, knowledgeBaseId])
  @@index([knowledgeBaseId])
  @@map("session_knowledge_bases")
}

// ==================== 研究报告 ====================
// 研究报告：丢主题 → 自动拆解子问题 → 检索知识库 → 分节撰写 → 汇总成 Markdown。
// 异步生成：创建任务立即返回，worker 后台执行，前端轮询 status/step 展示进度。

model Report {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  topic     String // 研究主题
  status    String   @default("pending") // pending / processing / done / failed
  step      Int      @default(0) // 进度步骤：1=拆解子问题 2=检索撰写章节 3=汇总成报告
  content   String? // 最终 Markdown 报告
  sections  Json? // [{ index, question, content }]
  sources   Json? // [{ number, documentId, chunkIndex, filename, similarity }]
  error     String? // 失败原因
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("reports")
}

// ==================== 用户模型配置（BYO 大模型 API） ====================
// 用户自带大模型 key（Cherry Studio 思路）：token 由用户买单，平台零成本。
// apiKey 用 AES-256-GCM 加密存储（密钥在服务端 env），接口永不返回明文。
// 会话可选一个配置：回答走用户的 key/baseURL/model；不配置则回退系统默认。
// 嵌入/检索仍用系统 key（保证检索质量一致、成本可控）。

model ModelConfig {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String // 备注名，如"我的 DeepSeek"
  baseURL   String   @default("https://api.deepseek.com") @map("base_url") // OpenAI 兼容接口地址
  apiKey    String   @map("api_key") // AES-GCM 密文（iv:tag:data base64）
  model     String // 模型名，如 deepseek-chat
  isDefault Boolean  @default(false) @map("is_default") // 新建会话默认使用
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([ownerId])
  @@map("model_configs")
}

// ==================== 对话消息 ====================
// 流式回答结束后才落库（中间态不写库），sources 存引用来源 JSON

model ChatMessage {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  role             String // user / assistant
  content          String // 完整消息内容
  sources          Json? // 引用来源：[{ documentId, filename, chunkIndex, content, similarity }]
  promptTokens     Int?     @map("prompt_tokens") // 流式请求输入 token（数据看板用）
  completionTokens Int?     @map("completion_tokens") // 流式请求输出 token
  createdAt        DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}
