// Prisma Schema - 数据模型定义
// 文档: https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector 扩展，用于存储向量
}

// ==================== 用户系统 ====================

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  nickname    String?
  avatar      String?
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  knowledgeBases KnowledgeBase[]
  chatSessions   ChatSession[]

  @@map("users")
}

// ==================== 知识库 ====================

model KnowledgeBase {
  id          String     @id @default(uuid())
  name        String
  description String?
  ownerId     String     @map("owner_id")
  documents   Document[]
  sessionLinks SessionKnowledgeBase[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("knowledge_bases")
}

// ==================== 文档 ====================

model Document {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  filename        String // 原始文件名
  filepath        String // 服务器上存储路径
  fileSize        Int      @map("file_size") // 字节数
  fileType        String   @map("file_type") // pdf / docx / md / txt
  status          String   @default("pending") // pending / processing / done / failed
  error           String? // 失败原因
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Chunk[]

  @@index([knowledgeBaseId])
  @@map("documents")
}

// ==================== 文本块（Chunk） ====================
// embedding 列类型是 pgvector 的 vector(1024)，Prisma 不支持，
// 用 Unsupported() 占位（列由原始 SQL 迁移创建，读写走 $executeRaw/$queryRaw）

model Chunk {
  id         String                    @id @default(uuid())
  documentId String                    @map("document_id")
  content    String // 文本块原文
  chunkIndex Int                       @map("chunk_index") // 第几块（保证顺序）
  embedding  Unsupported("vector(1024)")? // 向量（bge-m3 1024 维），Step 5 写入
  createdAt  DateTime                  @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// ==================== 对话会话 ====================
// 会话可以绑定 0..N 个知识库（多对多，通过关联表 SessionKnowledgeBase）；
// useKnowledgeBase=true 且 0 个绑定 = 检索该用户全部知识库；
// useKnowledgeBase=false = 纯对话模式（不检索知识库）

model ChatSession {
  id               String   @id @default(uuid())
  ownerId          String   @map("owner_id")
  title            String   @default("新对话")
  useKnowledgeBase Boolean  @default(true) @map("use_knowledge_base") // false = 纯对话，不检索知识库
  messages         ChatMessage[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases SessionKnowledgeBase[]

  @@index([ownerId])
  @@map("chat_sessions")
}

// 会话-知识库 多对多关联表
model SessionKnowledgeBase {
  sessionId       String        @map("session_id")
  knowledgeBaseId String        @map("knowledge_base_id")
  session         ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([sessionId, knowledgeBaseId])
  @@index([knowledgeBaseId])
  @@map("session_knowledge_bases")
}

// ==================== 对话消息 ====================
// 流式回答结束后才落库（中间态不写库），sources 存引用来源 JSON

model ChatMessage {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  role             String // user / assistant
  content          String // 完整消息内容
  sources          Json? // 引用来源：[{ documentId, filename, chunkIndex, content, similarity }]
  promptTokens     Int?     @map("prompt_tokens") // 流式请求输入 token（数据看板用）
  completionTokens Int?     @map("completion_tokens") // 流式请求输出 token
  createdAt        DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}
